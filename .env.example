# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.

# Connection string to your sprms_db database.
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://role_patient:patient_pass_change_me@localhost:5432/sprms_db

# Secret used to sign JWT session tokens (generate a long random string)
JWT_SECRET_KEY=replace-this-with-a-long-random-string

# How long a login token stays valid, in minutes
JWT_EXPIRE_MINUTES=15

# The pgcrypto symmetric key used for column encryption.
# This MUST match the key used in your pgAdmin test inserts.
PGCRYPTO_KEY=change-this-key
